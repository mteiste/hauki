{
  "_comment": "Copy this file to config.json and adjust values for your environment. config.json is ignored by git",

  "wifi": {
    "ssid": "YourNetworkName",
    "password": "YourWiFiPassword",
    "timeout": 10
  },

  "timezone": {
    "name": "Europe/Helsinki",
    "std_offset": 2,
    "dst_offset": 3,
    "dst_rules": {
      "_comment": "DST transition rules: week: 1-5 for nth occurrence, -1 for last; weekday: 0=Mon, 6=Sun",
      "start": {
        "month": 3,
        "week": -1,
        "weekday": 6,
        "hour": 3
      },
      "end": {
        "month": 10,
        "week": -1,
        "weekday": 6,
        "hour": 4
      }
    }
  },

  "homeassistant": {
    "_comment": "Home Assistant REST API settings. Get a long-lived access token from your HA profile",
    "url": "http://homeassistant.local:8123",
    "token": "your-long-lived-access-token-here",
    "timeout": 10
  },

  "nordpool": {
    "_comment": "Nord Pool: entity_id, slot_duration in seconds (900=15min), refresh_interval in seconds (14400=4h)",
    "entity_id": "sensor.nordpool_kwh_fi_eur_3_10_0255",
    "slot_duration": 900,
    "refresh_interval": 14400
  }
}
