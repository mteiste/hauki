# Local configuration for Raspberry Pi Pico development
# REQUIRED: Copy this file to config.mk and adjust for your environment
# config.mk is ignored by git

# Serial port for Pico connection (REQUIRED)
# Common values: /dev/ttyACM0, /dev/ttyUSB0, /dev/ttyUSB1
PORT = /dev/ttyACM0

# Font for display text (REQUIRED for custom fonts)
# This font will be used to generate MicroPython font files with font-to-py
# DejaVu Sans is recommended - clean, supports Finnish characters (ä, ö, å)
# Common paths:
#   Ubuntu/Debian: /usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
#   Fedora/RHEL:   /usr/share/fonts/dejavu-sans-fonts/DejaVuSans.ttf
#   Arch Linux:    /usr/share/fonts/TTF/DejaVuSans.ttf
#   macOS:         /Library/Fonts/Arial.ttf or /System/Library/Fonts/Helvetica.ttc
# To find fonts: fc-list | grep -i dejavu
FONT_PATH = /usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

# Font sizes for general text (used by 'make fonts' target)
# These fonts include full character set with Finnish letters (ä, ö, å)
# Note: font64 is auto-generated during 'make prepare' with minimal charset (0-9, ., -)
# for price display - it is not included in this list
FONT_SIZES = 12 14 32
