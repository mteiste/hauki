[Unit]
Description=HAUKI - Home Assistant Update Kiosk Interface
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hauki
Group=hauki
WorkingDirectory=/opt/hauki
ExecStart=/usr/bin/python3 src/main.py
# lgpio creates a notification pipe in $LG_WD on import; /run/hauki is writable by
# the service and cleaned up by systemd
RuntimeDirectory=hauki
Environment=LG_WD=/run/hauki
# The code directory is read-only for the service, and the SD card should not get
# bytecode cache writes
Environment=PYTHONDONTWRITEBYTECODE=1
# Error output reaches the journal immediately
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
